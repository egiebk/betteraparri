  "content": {
    "hero": {
      "eyebrow": "Financial Stewardship",
      "title": "Regular Income and Dependence on National Funds",
      "description": "Where Aparri's regular yearly income comes from, and how much of it depends on money from the national government."
    },
    "intro": "Aparri's regular income has two main sources: money the town collects itself (local taxes, fees and earnings from public markets and other town-run businesses) and its share of national taxes, called the National Tax Allotment (NTA). The more a town relies on the NTA, the less control it has over its own budget.",
    "sections": {
      "overview": {
        "eyebrow": "At a Glance",
        "title": "Regular Income",
        "description": "Total regular income for the selected year and where it came from."
      },
      "local": {
        "eyebrow": "Local Collections",
        "title": "What the Town Collects Itself",
        "description": "Taxes, fees and earnings collected by the municipal government."
      },
      "trend": {
        "eyebrow": "Over Time",
        "title": "Income by Year",
        "description": "Money collected locally and money from the national government, year by year. Select a bar to view that year."
      }
    },
    "terms": [
      {
        "term": "Annual Regular Income (ARI)",
        "description": "Money the town receives every year that it can count on: local collections, the NTA, and other shares of national taxes. It leaves out one-time grants and loans."
      },
      {
        "term": "National Tax Allotment (NTA)",
        "description": "The town's share of national taxes, sent by the national government. It was called the Internal Revenue Allotment (IRA) before 2022."
      },
      {
        "term": "Locally sourced revenue",
        "description": "Money the town collects itself: real property tax, business tax, other taxes, regulatory fees, service charges, and earnings from town-run businesses."
      },
      {
        "term": "Dependence on national funds",
        "description": "The share of regular income that comes from the NTA and other national tax shares. A high share means the town relies heavily on the national government."
      },
      {
        "term": "Per resident",
        "description": "The amount divided by Aparri's estimated population that year, to show what it means for each person."
      }
    ],
    "sourceNote": "Figures are from the Bureau of Local Government Finance (BLGF) annual \"ARI and Dependencies\" files by LGU. FY 2025 figures are preliminary and may change. Per-resident amounts use mid-year population estimates between the 2015, 2020 and 2024 census counts."
  }
