  "content": {
    "hero": {
      "eyebrow": "Financial Stewardship",
      "title": "Receipts and Expenditures",
      "description": "How much money came into the town each year, what it was spent on, and how much was left."
    },
    "intro": "Every year, the town reports all the money it received and spent to the Bureau of Local Government Finance (BLGF). This page shows that report in simple terms: money in, money spent on day-to-day services, money spent on projects and equipment, and the cash left at the end of the year.",
    "sections": {
      "overview": {
        "eyebrow": "At a Glance",
        "title": "Money In and Money Out",
        "description": "The selected year's income, spending and cash balance."
      },
      "moneyInOut": {
        "eyebrow": "Details",
        "title": "Where the Money Came From and Went",
        "description": "Income by source and day-to-day spending by type of service for the selected year."
      },
      "income": {
        "eyebrow": "Money In",
        "title": "Where the Money Came From",
        "description": "Income from local collections and from outside sources such as the national government."
      },
      "spending": {
        "eyebrow": "Money Out",
        "title": "What the Money Was Spent On",
        "description": "Day-to-day spending by type of service, plus spending on projects and equipment."
      },
      "trend": {
        "eyebrow": "Over Time",
        "title": "Income and Spending by Year",
        "description": "Money received and money spent on day-to-day operations, year by year. Select a year to view it."
      }
    },
    "terms": [
      {
        "term": "Current operating income",
        "description": "Money received during the year from taxes, fees, the National Tax Allotment, grants and transfers. It does not include loans."
      },
      {
        "term": "Current operating expenditures",
        "description": "Money spent on day-to-day services: salaries, supplies, utilities and programs."
      },
      {
        "term": "Capital outlay",
        "description": "Money spent on things that last, such as buildings, roads, vehicles and equipment."
      },
      {
        "term": "General public services",
        "description": "Running the town government itself: the mayor's office, council, treasury, assessor, and other administrative offices."
      },
      {
        "term": "Economic services",
        "description": "Programs that support livelihoods and the local economy, such as agriculture, fisheries, public markets and engineering."
      },
      {
        "term": "Net operating income",
        "description": "Money received minus day-to-day spending. A positive number means income covered the town's regular operations."
      },
      {
        "term": "Cash at year end",
        "description": "Money left in the town's funds after all payments and amounts set aside for ongoing projects."
      }
    ],
    "sourceNote": "Figures are from the Bureau of Local Government Finance (BLGF) annual \"Statement of Receipts and Expenditures (SRE)\" files by LGU. FY 2025 figures are preliminary and may change. Per-resident amounts use mid-year population estimates between the 2015, 2020 and 2024 census counts."
  }
